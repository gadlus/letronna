+def _actions_consistent(by_id: dict[str, dict[str, str]], expected: dict[str, Any]) -> bool:
+    delayed: dict[str, set[int]] = {}
+    for sid, exp in expected.items():
+        action = by_id.get(sid, {}).get("action", "")
+        if action not in _ACTION_RANK:
