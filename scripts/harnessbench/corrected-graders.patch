+    if any(len(ranks) > 1 for ranks in delayed.values()):
+        return False
+    by_tier = {tier: next(iter(ranks)) for tier, ranks in delayed.items()}
+    ranks = [by_tier[t] for t in sorted(by_tier, key=lambda t: _TIER_RANK.get(t, -1))]
+    if ranks != sorted(ranks):
+        return False
+    if "standard" in by_tier and "vip" in by_tier and not by_tier["vip"] > by_tier["standard"]:
+        return False
+    return True
