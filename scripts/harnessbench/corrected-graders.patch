+    if action == "expedite_replacement":
+        return bool(re.search(_REPLACEMENT, comp, re.IGNORECASE))
+    if action in ("monitor", "notify"):
+        return bool(re.search(_NONE, comp, re.IGNORECASE)) or not re.search(_CREDIT + "|" + _REPLACEMENT, comp, re.IGNORECASE)
