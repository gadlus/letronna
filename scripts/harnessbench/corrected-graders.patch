+_ACTION_RANK = {"monitor": 0, "notify": 1, "offer_credit": 2, "expedite_replacement": 3}
+_TIER_RANK = {"standard": 0, "premium": 1, "vip": 2}
+# Compensation has no vocabulary in the prompt; it must fit the row's own action: a credit
