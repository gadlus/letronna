+# A busy gateway answers 429 or 5xx, or drops the connection, and one such
+# answer used to leave the run ungraded. Seconds to wait before each new try.
+_RETRY_WAITS_SEC = (10, 30, 60)
+
+
+def _post_with_retries(req: urllib.request.Request, timeout: int) -> Any:
+    for wait in (*_RETRY_WAITS_SEC, None):
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as resp:
+                return json.loads(resp.read().decode("utf-8"))
+        except urllib.error.HTTPError as e:
+            if wait is None or not (e.code == 429 or e.code >= 500):
+                raise
+        except (urllib.error.URLError, TimeoutError, ConnectionError):
+            if wait is None:
+                raise
+        time.sleep(wait)
+
